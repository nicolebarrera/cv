.flow{list-style:none;padding:0;margin:16px 0 8px;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:0;max-width:none}
.flow li{position:relative;padding:0 14px 0 0;margin:0;display:flex;flex-direction:column;gap:4px}
.flow li::before{content:"";position:absolute;top:15px;left:32px;right:0;height:1px;background:var(--line)}
.flow li:last-child::before{display:none}
.f-n{width:30px;height:30px;border-radius:50%;background:var(--ink);color:var(--bg);display:flex;align-items:center;justify-content:center;font-size:.85rem;font-weight:600;position:relative;z-index:1;margin-bottom:8px}
.flow strong{color:var(--ink);font-size:.95rem;line-height:1.3}
.f-d{font-size:.86rem;color:var(--muted);line-height:1.45}
