<script>
(function(){
  var root=document.documentElement;
  var titles={en:'Nicole Barrera Wong | Portfolio',es:'Nicole Barrera Wong | Portfolio'};
  function setLang(l){
    root.classList.remove('ui-en','ui-es'); root.classList.add('ui-'+l); root.lang=l;
    document.querySelectorAll('.langswitch button').forEach(function(b){b.setAttribute('aria-pressed', b.dataset.lang===l?'true':'false');});
    document.querySelector('nav').setAttribute('aria-label', l==='es'?'Áreas de trabajo':'Areas of work');
    try{localStorage.setItem('lang',l);}catch(e){}
  }
  var saved=null; try{saved=localStorage.getItem('lang');}catch(e){}
  var start=saved||((navigator.language||'').toLowerCase().indexOf('es')===0?'es':'en');
  setLang(start);
  document.querySelectorAll('.langswitch button').forEach(function(b){b.addEventListener('click',function(){setLang(b.dataset.lang);});});
})();
(function(){
  var views=['overview','crm','web','content','seo','geo','data'];
  var tabs=document.querySelectorAll('[role="tab"]');
  function show(name, focus){
    if(views.indexOf(name)<0) name='overview';
    tabs.forEach(function(t){
      var on=t.dataset.view===name;
      t.setAttribute('aria-selected',on?'true':'false');
      t.tabIndex=on?0:-1;
      document.getElementById(t.dataset.view).hidden=!on;
      if(on){ if(focus) t.focus(); t.scrollIntoView({block:'nearest',inline:'nearest'}); }
    });
  }
  tabs.forEach(function(t,i){
    t.addEventListener('click',function(){
      if(location.hash!=='#'+t.dataset.view){ location.hash=t.dataset.view; } else { show(t.dataset.view); }
    });
    t.addEventListener('keydown',function(e){
      var j=null;
      if(e.key==='ArrowRight') j=(i+1)%tabs.length;
      if(e.key==='ArrowLeft') j=(i-1+tabs.length)%tabs.length;
      if(j!==null){ e.preventDefault(); location.hash=tabs[j].dataset.view; show(tabs[j].dataset.view,true); }
    });
  });
  window.addEventListener('hashchange',function(){
    show(location.hash.slice(1));
    var nav=document.querySelector('nav');
    if(window.scrollY>nav.offsetTop) window.scrollTo({top:nav.offsetTop});
  });
  show(location.hash.slice(1));
})();
(function(){
  var d=document.getElementById('lightbox'); var im=d.querySelector('img');
  document.querySelectorAll('.nl-open').forEach(function(b){b.addEventListener('click',function(){im.src=b.querySelector('img').src; if(d.showModal) d.showModal();});});
  d.querySelector('.close').addEventListener('click',function(){d.close();});
  d.addEventListener('click',function(e){if(e.target===d) d.close();});
})();
</script>
