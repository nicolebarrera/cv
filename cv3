.work.has-img{padding-top:12px}
.work-img{display:block;aspect-ratio:16/10;overflow:hidden;border-radius:6px;border:1px solid var(--line);margin:0 -6px 8px;background:var(--soft)}
.work-img img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
