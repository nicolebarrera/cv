.project .results{margin:8px 0 12px;padding-left:14px}
.project .results p{font-size:.93rem}
.tag{align-self:flex-start;font-size:.78rem;color:var(--ink);background:var(--soft);border-radius:999px;padding:2px 10px;margin:-2px 0 10px}
h4.sub{font-family:Lora,Georgia,serif;font-weight:500;font-size:1.05rem;color:var(--ink);margin:22px 0 8px}
