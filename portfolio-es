<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300;1,9..144,400&family=Instrument+Sans:wght@400;500;600&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --navy: #0f2239;
  --gold: #c8a96e;
  --cream: #f7f4ef;
  --warm: #ede9e1;
  --text: #1c1c1e;
  --muted: #6b6560;
  --border: #ddd8cf;
  --white: #ffffff;
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Instrument Sans', sans-serif;
  background: var(--cream);
  color: var(--text);
  font-size: 16px;
  line-height: 1.6;
  overflow-x: hidden;
}

nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 60px;
  background: rgba(247,244,239,0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}

.nav-logo { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 400; color: var(--navy); letter-spacing: -0.3px; }

.nav-links { display: flex; gap: 36px; list-style: none; }
.nav-links a { text-decoration: none; font-size: 13px; font-weight: 500; color: var(--muted); letter-spacing: 0.5px; text-transform: uppercase; transition: color 0.2s; }
.nav-links a:hover { color: var(--navy); }

.lang-toggle { display: flex; gap: 8px; }
.lang-btn { background: none; border: 1px solid var(--border); padding: 4px 12px; font-size: 12px; font-weight: 500; font-family: 'Instrument Sans', sans-serif; cursor: pointer; border-radius: 2px; color: var(--muted); transition: all 0.2s; text-decoration: none; display: inline-block; }
.lang-btn.active { background: var(--navy); border-color: var(--navy); color: var(--white); }

.hero { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; padding-top: 80px; }

.hero-left { padding: 80px 60px 60px 60px; display: flex; flex-direction: column; justify-content: center; }

.hero-eyebrow { font-size: 11px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); margin-bottom: 24px; }

.hero-name { font-family: 'Fraunces', serif; font-size: clamp(44px, 5vw, 72px); font-weight: 300; line-height: 1.05; color: var(--navy); letter-spacing: -1px; margin-bottom: 8px; }
.hero-name em { font-style: italic; color: var(--gold); }

.hero-title { font-family: 'Fraunces', serif; font-size: clamp(18px, 2.2vw, 27px); font-weight: 300; color: var(--muted); margin-bottom: 32px; line-height: 1.35; }

.hero-desc { font-size: 15px; color: var(--muted); max-width: 420px; line-height: 1.75; margin-bottom: 40px; }

.hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }

.btn-primary { background: var(--navy); color: var(--white); padding: 14px 28px; text-decoration: none; font-size: 13px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; border-radius: 2px; transition: background 0.2s; display: inline-block; }
.btn-primary:hover { background: #1a3a5c; }

.btn-outline { border: 1.5px solid var(--navy); color: var(--navy); padding: 13px 28px; text-decoration: none; font-size: 13px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; border-radius: 2px; transition: all 0.2s; display: inline-block; }
.btn-outline:hover { background: var(--navy); color: var(--white); }

.hero-right { background: var(--navy); display: flex; flex-direction: column; justify-content: flex-end; padding: 60px; position: relative; overflow: hidden; }
.hero-right::before { content: ''; position: absolute; top: -100px; right: -100px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(200,169,110,0.15) 0%, transparent 70%); pointer-events: none; }

.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; position: relative; z-index: 1; }
.stat-card { background: rgba(255,255,255,0.05); padding: 28px 24px; border: 1px solid rgba(255,255,255,0.08); transition: background 0.2s; }
.stat-card:hover { background: rgba(255,255,255,0.09); }
.stat-number { font-family: 'Fraunces', serif; font-size: 36px; font-weight: 300; color: var(--gold); line-height: 1; margin-bottom: 8px; }
.stat-label { font-size: 11px; color: rgba(255,255,255,0.5); font-weight: 500; letter-spacing: 0.5px; text-transform: uppercase; line-height: 1.4; }

.expertise { background: var(--white); padding: 100px 60px; }

.section-header { display: grid; grid-template-columns: 1fr 2fr; gap: 60px; align-items: start; margin-bottom: 64px; }

.section-label { font-size: 11px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); padding-top: 8px; }

.section-heading { font-family: 'Fraunces', serif; font-size: clamp(32px, 4vw, 52px); font-weight: 300; line-height: 1.1; color: var(--navy); letter-spacing: -0.5px; }
.section-heading em { font-style: italic; color: var(--gold); }

.expertise-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }

.expertise-card { background: var(--cream); padding: 36px 28px; border-top: 3px solid transparent; transition: border-color 0.2s, background 0.2s; }
.expertise-card:hover { border-color: var(--gold); background: var(--warm); }

.expertise-number { font-family: 'Fraunces', serif; font-size: 48px; font-weight: 300; color: var(--border); line-height: 1; margin-bottom: 16px; }
.expertise-title { font-size: 16px; font-weight: 600; color: var(--navy); margin-bottom: 12px; }
.expertise-desc { font-size: 14px; color: var(--muted); line-height: 1.65; }
.expertise-tags { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 6px; }
.tag { font-size: 11px; background: var(--border); color: var(--muted); padding: 3px 9px; border-radius: 2px; font-weight: 500; }

.achievements { background: var(--navy); padding: 100px 60px; }
.achievements .section-heading { color: var(--white); }
.achievements-list { margin-top: 64px; display: grid; gap: 2px; }

.achievement-row { display: grid; grid-template-columns: 120px 1fr auto; gap: 40px; align-items: center; background: rgba(255,255,255,0.04); padding: 32px 36px; border-left: 3px solid transparent; transition: border-color 0.2s, background 0.2s; cursor: default; }
.achievement-row:hover { border-left-color: var(--gold); background: rgba(255,255,255,0.07); }

.achievement-metric { font-family: 'Fraunces', serif; font-size: 32px; font-weight: 300; color: var(--gold); line-height: 1; }
.achievement-metric small { display: block; font-size: 11px; color: rgba(255,255,255,0.35); font-family: 'Instrument Sans', sans-serif; font-weight: 500; letter-spacing: 0.5px; text-transform: uppercase; margin-top: 4px; }

.achievement-text { font-size: 15px; color: rgba(255,255,255,0.75); line-height: 1.6; }
.achievement-text strong { color: var(--white); font-weight: 600; display: block; margin-bottom: 4px; font-size: 16px; }
.achievement-year { font-size: 12px; color: rgba(255,255,255,0.25); text-align: right; white-space: nowrap; }

.experience { background: var(--cream); padding: 100px 60px; }

.timeline { margin-top: 64px; position: relative; padding-left: 40px; border-left: 2px solid var(--border); }
.timeline-item { position: relative; margin-bottom: 48px; padding-bottom: 48px; border-bottom: 1px solid var(--border); }
.timeline-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.timeline-dot { position: absolute; left: -49px; top: 6px; width: 16px; height: 16px; border-radius: 50%; background: var(--white); border: 2px solid var(--gold); }
.timeline-date { font-size: 12px; font-weight: 600; color: var(--gold); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; }
.timeline-company { font-family: 'Fraunces', serif; font-size: 24px; font-weight: 400; color: var(--navy); margin-bottom: 4px; }
.timeline-role { font-size: 14px; font-weight: 600; color: var(--muted); margin-bottom: 16px; }

.timeline-highlights { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 16px; }
.highlight-pill { background: var(--white); border: 1px solid var(--border); padding: 12px 16px; border-radius: 3px; font-size: 13px; color: var(--text); line-height: 1.45; }
.highlight-pill strong { color: var(--navy); display: block; margin-bottom: 2px; }

.skills-section { background: var(--white); padding: 100px 60px; }
.skills-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; margin-top: 64px; }
.skills-category h3 { font-size: 12px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
.skills-list { list-style: none; }
.skills-list li { font-size: 14px; color: var(--muted); padding: 7px 0; border-bottom: 1px solid var(--warm); display: flex; align-items: center; gap: 8px; }
.skills-list li::before { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }

.contact { background: var(--navy); padding: 80px 60px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.contact-left h2 { font-family: 'Fraunces', serif; font-size: clamp(32px, 4vw, 52px); font-weight: 300; color: var(--white); line-height: 1.1; margin-bottom: 20px; }
.contact-left h2 em { font-style: italic; color: var(--gold); }
.contact-left p { font-size: 15px; color: rgba(255,255,255,0.6); line-height: 1.7; }
.contact-right { display: flex; flex-direction: column; gap: 16px; }
.contact-item { display: flex; align-items: center; gap: 16px; padding: 20px 24px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); border-radius: 3px; text-decoration: none; transition: background 0.2s; }
.contact-item:hover { background: rgba(255,255,255,0.1); }
.contact-icon { width: 36px; height: 36px; background: var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; color: var(--navy); font-weight: 700; }
.contact-type { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 2px; }
.contact-value { font-size: 15px; color: var(--white); font-weight: 500; }

footer { background: #080f1a; padding: 28px 60px; display: flex; justify-content: space-between; align-items: center; }
footer p { font-size: 12px; color: rgba(255,255,255,0.3); }

@keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
.hero-left > * { animation: fadeUp 0.6s ease both; }
.hero-eyebrow { animation-delay: 0.1s; }
.hero-name    { animation-delay: 0.2s; }
.hero-title   { animation-delay: 0.3s; }
.hero-desc    { animation-delay: 0.4s; }
.hero-ctas    { animation-delay: 0.5s; }

@media (max-width: 900px) {
  nav { padding: 16px 24px; }
  .hero { grid-template-columns: 1fr; }
  .hero-right { min-height: 300px; padding: 40px 24px; }
  .hero-left { padding: 80px 24px 40px; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .expertise { padding: 60px 24px; }
  .section-header { grid-template-columns: 1fr; gap: 16px; }
  .expertise-grid { grid-template-columns: 1fr; }
  .achievements { padding: 60px 24px; }
  .achievement-row { grid-template-columns: 80px 1fr; gap: 20px; }
  .achievement-year { display: none; }
  .experience { padding: 60px 24px; }
  .timeline-highlights { grid-template-columns: 1fr; }
  .skills-section { padding: 60px 24px; }
  .skills-grid { grid-template-columns: repeat(2, 1fr); }
  .contact { grid-template-columns: 1fr; padding: 60px 24px; }
  footer { padding: 24px; flex-direction: column; gap: 8px; text-align: center; }
}
</style>
</head>
